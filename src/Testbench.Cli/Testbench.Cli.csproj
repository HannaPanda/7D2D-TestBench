<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Testbench.Core\Testbench.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- The whole point of this tool is that nobody has to remember a long
         command line, so the executable is called "tb", not "Testbench.Cli". -->
    <AssemblyName>tb</AssemblyName>
  </PropertyGroup>

</Project>
