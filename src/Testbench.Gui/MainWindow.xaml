<Window x:Class="Testbench.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Testbench.Gui"
        Title="7DTD Multiversion-Testbench" Height="820" Width="1360"
        Background="#12141A" Foreground="#E4E7EC"
        TextOptions.TextFormattingMode="Display"
        Closing="Window_Closing">

    <Window.Resources>
        <local:LogKindBrushConverter x:Key="LogBrush" />
        <local:OkBrushConverter x:Key="OkBrush" />
        <local:NotEmptyToVisibilityConverter x:Key="NotEmpty" />
        <local:CountToVisibilityConverter x:Key="HasItems" />

        <SolidColorBrush x:Key="Panel" Color="#1A1D25" />
        <SolidColorBrush x:Key="Line" Color="#2B303B" />
        <SolidColorBrush x:Key="Muted" Color="#8A93A6" />
        <SolidColorBrush x:Key="Accent" Color="#5FB3F5" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E4E7EC" />
        </Style>

        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E4E7EC" />
            <Setter Property="Margin" Value="0,3,0,3" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#242938" />
            <Setter Property="Foreground" Value="#E4E7EC" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#1E5F94" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Padding" Value="6,4" />
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- top bar -->
        <Border Grid.Row="0" Background="{StaticResource Panel}" CornerRadius="7" Padding="12"
                BorderBrush="{StaticResource Line}" BorderThickness="1" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="7DTD Multiversion-Testbench" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding MachinePath}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0" />
                    <TextBlock Text="{Binding ConfigProblem}" Foreground="#F07178" FontSize="12" Margin="0,5,0,0"
                               TextWrapping="Wrap"
                               Visibility="{Binding ConfigProblem, Converter={StaticResource NotEmpty}}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource Accent}"
                               VerticalAlignment="Center" Margin="0,0,14,0" />
                    <Button Content="doctor" Click="Doctor_Click" IsEnabled="{Binding NotBusy}" Margin="0,0,8,0" />
                    <Button Content="Ordner oeffnen" Click="OpenBench_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- middle -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="350" />
            </Grid.ColumnDefinitions>

            <!-- left: what to run -->
            <Border Grid.Column="0" Background="{StaticResource Panel}" CornerRadius="7" Padding="12"
                    BorderBrush="{StaticResource Line}" BorderThickness="1" Margin="0,0,12,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="MOD" Style="{StaticResource Heading}" />
                        <ComboBox ItemsSource="{Binding Mods}" SelectedItem="{Binding SelectedMod}"
                                  DisplayMemberPath="DisplayName" />

                        <TextBlock Text="VARIANTE" Style="{StaticResource Heading}" />
                        <ComboBox ItemsSource="{Binding Variants}" SelectedItem="{Binding SelectedVariant}"
                                  DisplayMemberPath="Name" />

                        <TextBlock Text="PROFIL" Style="{StaticResource Heading}" />
                        <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}"
                                  DisplayMemberPath="Name" />

                        <TextBlock Text="VERSIONEN" Style="{StaticResource Heading}" Margin="0,6,0,6" />
                        <ItemsControl ItemsSource="{Binding Versions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding Label}"
                                              ToolTip="{Binding Notes}" IsEnabled="{Binding Installed}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="STUFEN" Style="{StaticResource Heading}" Margin="0,14,0,6" />
                        <CheckBox IsChecked="{Binding StageHeadless}" Content="Stufe 1: headless" />
                        <TextBlock Text="Mod-Laden, Harmony, XML, Localization. Nichts Grafisches."
                                   Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="22,0,0,6" />
                        <CheckBox IsChecked="{Binding StageGui}" Content="Stufe 2: mit Fenster" />
                        <TextBlock Text="Atlas, Menues, Tasten, Spielgefuehl. Endet, wenn du das Fenster schliesst."
                                   Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="22,0,0,6" />

                        <CheckBox IsChecked="{Binding SkipDeploy}" Content="Ohne Deploy (nimmt, was liegt)"
                                  Margin="0,10,0,0" />

                        <Button Content="Lauf starten" Style="{StaticResource PrimaryButton}"
                                Click="Run_Click" IsEnabled="{Binding CanRun}" Margin="0,16,0,0" />
                        <Button Content="Abbrechen" Click="Cancel_Click" IsEnabled="{Binding Busy}" Margin="0,7,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- centre: live log -->
            <Border Grid.Column="1" Background="#0D0F14" CornerRadius="7"
                    BorderBrush="{StaticResource Line}" BorderThickness="1" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="12,10,12,6">
                        <TextBlock Text="LAUFENDES LOG" Style="{StaticResource Heading}" Margin="0" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <CheckBox x:Name="AutoScroll" Content="mitlaufen" IsChecked="True" FontSize="11"
                                      Margin="0,0,10,0" VerticalAlignment="Center" />
                            <Button Content="leeren" Click="ClearLog_Click" Padding="8,2" FontSize="11" />
                        </StackPanel>
                    </Grid>

                    <ListBox x:Name="LogList" Grid.Row="1" ItemsSource="{Binding LogLines}"
                             Background="Transparent" BorderThickness="0" Foreground="#E4E7EC"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Text}" FontFamily="Cascadia Mono, Consolas" FontSize="11.5"
                                           Padding="12,1" TextWrapping="NoWrap"
                                           Foreground="{Binding Kind, Converter={StaticResource LogBrush}}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- right: results -->
            <Border Grid.Column="2" Background="{StaticResource Panel}" CornerRadius="7" Padding="12"
                    BorderBrush="{StaticResource Line}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="ERGEBNISSE" Style="{StaticResource Heading}" />

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Results}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#171A22" CornerRadius="6" Padding="10" Margin="0,0,0,8"
                                            BorderThickness="0,0,0,3"
                                            BorderBrush="{Binding Ok, Converter={StaticResource OkBrush}}">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Status}" HorizontalAlignment="Right"
                                                           FontWeight="SemiBold"
                                                           Foreground="{Binding Ok, Converter={StaticResource OkBrush}}" />
                                            </Grid>
                                            <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Muted}"
                                                       FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" />
                                            <Button Content="Log oeffnen" Click="OpenLog_Click" Tag="{Binding LogPath}"
                                                    HorizontalAlignment="Left" Padding="8,3" FontSize="11" Margin="0,8,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Margin="0,10,0,0">
                        <TextBlock Text="KOMPATIBILITAET" Style="{StaticResource Heading}" />
                        <TextBlock Text="{Binding ReportSummary}" Foreground="{StaticResource Muted}"
                                   FontSize="11" TextWrapping="Wrap" />
                        <Border Background="#0D0F14" CornerRadius="5" Padding="8" Margin="0,8,0,0">
                            <TextBlock Text="{Binding TestedVersions}" FontFamily="Cascadia Mono, Consolas"
                                       FontSize="12" Foreground="#7BD88F" TextWrapping="Wrap" />
                        </Border>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="kopieren" Click="Copy_Click" Margin="0,0,4,0" FontSize="11" />
                            <Button Grid.Column="1" Content="Report schreiben" Click="Report_Click" Margin="4,0,0,0" FontSize="11" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- pending visual checks -->
        <Border Grid.Row="2" Background="#20180C" CornerRadius="7" Padding="12" Margin="0,12,0,0"
                BorderBrush="#7A5A1E" BorderThickness="1"
                Visibility="{Binding Pending.Count, Converter={StaticResource HasItems}}">
            <StackPanel>
                <TextBlock Text="OFFENE SICHTPRUEFUNGEN" Style="{StaticResource Heading}" Foreground="#E8B44A" />
                <TextBlock Text="Das kann kein Logmuster beantworten. Nur wer hingesehen hat, darf hier klicken."
                           Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,8" />
                <ItemsControl ItemsSource="{Binding Pending}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#171A22" CornerRadius="6" Padding="10" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Header}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Question}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                        <TextBlock Text="{Binding Evidence}" FontSize="11" Margin="0,4,0,0"
                                                   Foreground="{Binding EvidenceOk, Converter={StaticResource OkBrush}}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="Ja" Click="VisualOk_Click" Tag="{Binding}" Margin="0,0,6,0"
                                                Background="#1E6B3A" MinWidth="64" />
                                        <Button Content="Nein" Click="VisualFail_Click" Tag="{Binding}"
                                                Background="#6B2020" MinWidth="64" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="3" Margin="2,10,0,0" FontSize="11" Foreground="{StaticResource Muted}"
                   TextWrapping="Wrap"
                   Text="Headless deckt nichts Grafisches und nichts Eingabebezogenes ab. Eine Version kommt erst auf die Kompatibilitaetsliste, wenn beide Stufen bestanden sind und die Sichtpruefung fuer die aktuelle Mod-Version bestaetigt wurde." />
    </Grid>
</Window>
